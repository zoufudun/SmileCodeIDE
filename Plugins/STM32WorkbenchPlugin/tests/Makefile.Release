	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\moc_BuildManager.o moc\moc_BuildManager.cpp

####### Install

install_target: first FORCE
	@if not exist D:$(INSTALL_ROOT:@msyshack@%=%)\Soft\Qt\6.11.1\mingw_64\tests\tests mkdir D:$(INSTALL_ROOT:@msyshack@%=%)\Soft\Qt\6.11.1\mingw_64\tests\tests & if not exist D:$(INSTALL_ROOT:@msyshack@%=%)\Soft\Qt\6.11.1\mingw_64\tests\tests exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) D:$(INSTALL_ROOT:@msyshack@%=%)\Soft\Qt\6.11.1\mingw_64\tests\tests\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) D:$(INSTALL_ROOT:@msyshack@%=%)\Soft\Qt\6.11.1\mingw_64\tests\tests\$(TARGET)
	-$(DEL_DIR) D:$(INSTALL_ROOT:@msyshack@%=%)\Soft\Qt\6.11.1\mingw_64\tests\tests 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

