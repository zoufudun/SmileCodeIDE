/* Noctis Theme */

/* 主窗口样式 */
QMainWindow {
    background-color: #1B2932;
    color: #C2CCDB;
}

/* 菜单栏样式 */
QMenuBar {
    background-color: #1B2932;
    color: #C2CCDB;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #2F3B45;
    color: #7FC1CA;
}

/* 菜单样式 */
QMenu {
    background-color: #1B2932;
    color: #C2CCDB;
    border: 1px solid #2F3B45;
}

QMenu::item {
    padding: 5px 30px 5px 20px;
}

QMenu::item:selected {
    background-color: #2F3B45;
    color: #7FC1CA;
}

/* 工具栏样式 */
QToolBar {
    background-color: #1B2932;
    border: none;
    spacing: 3px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 3px;
}

QToolButton:hover {
    background-color: #2F3B45;
    border: 1px solid #2F3B45;
}

QToolButton:pressed {
    background-color: #121920;
}

/* 状态栏样式 */
QStatusBar {
    background-color: #1B2932;
    color: #C2CCDB;
}

/* 标签页样式 */
QTabWidget::pane {
    border: 1px solid #2F3B45;
    background-color: #1B2932;
}

QTabBar::tab {
    background-color: #1B2932;
    color: #C2CCDB;
    padding: 5px 10px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:selected {
    background-color: #2F3B45;
    border-bottom: 2px solid #7FC1CA;
}

QTabBar::tab:!selected {
    background-color: #1B2932;
}

/* 按钮样式 */
QPushButton {
    background-color: #2F3B45;
    color: #C2CCDB;
    border: 1px solid #3D4D5A;
    border-radius: 3px;
    padding: 5px 15px;
}

QPushButton:hover {
    background-color: #3D4D5A;
}

QPushButton:pressed {
    background-color: #1B2932;
}

/* 输入框样式 */
QLineEdit {
    background-color: #2F3B45;
    color: #C2CCDB;
    border: 1px solid #3D4D5A;
    border-radius: 3px;
    padding: 3px;
}

/* 下拉框样式 */
QComboBox {
    background-color: #2F3B45;
    color: #C2CCDB;
    border: 1px solid #3D4D5A;
    border-radius: 3px;
    padding: 3px 3px 3px 7px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #3D4D5A;
}

/* 树视图样式 */
QTreeView {
    background-color: #1B2932;
    color: #C2CCDB;
    border: 1px solid #2F3B45;
}

QTreeView::item {
    padding: 3px;
}

QTreeView::item:selected {
    background-color: #2F3B45;
    color: #7FC1CA;
}

/* 文本编辑器样式 */
QPlainTextEdit, QTextEdit {
    background-color: #1B2932;
    color: #C2CCDB;
    border: 1px solid #2F3B45;
    selection-background-color: #3D4D5A;
    selection-color: #7FC1CA;
}

/* 滚动条样式 */
QScrollBar:vertical {
    background-color: #1B2932;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2F3B45;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3D4D5A;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1B2932;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #2F3B45;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3D4D5A;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 特殊的Noctis主题元素 */
QPushButton#debugButton {
    background-color: #7FC1CA;
    color: #1B2932;
}

QPushButton#debugButton:hover {
    background-color: #8FD1DA;
}